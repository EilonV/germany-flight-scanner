# Copy to .env and fill in. NEVER commit .env
# 1) Telegram bot token from @BotFather  (/newbot)
TELEGRAM_BOT_TOKEN=
# 2) Your chat id: message the bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates -> result[0].message.chat.id
#    Or just message @userinfobot, which replies with your numeric id.
TELEGRAM_CHAT_ID=
# 3) Alert when a round-trip total drops below this (NIS).
#    Measured floor on this route is ~1700 NIS, so 800 will not fire on its own.
PRICE_THRESHOLD_NIS=800
# Also alert whenever a new all-time-low is seen, regardless of threshold
ALERT_ON_NEW_LOW=true
